<%- include("../partials/lms-layout-start", { lmsPageTitle, lmsActive }) %>

<section class="lms-section">
  <h2>Assignments Queue</h2>
  <div class="lms-grid cols-3">
    <article class="lms-card">
      <h4>API Security Quiz</h4>
      <p class="muted">Course: Web Development Bootcamp</p>
      <span class="status-chip warn">Due in 2 days</span>
    </article>
    <article class="lms-card">
      <h4>Deployment Checklist</h4>
      <p class="muted">Course: AWS Cloud Practitioner</p>
      <span class="status-chip">Due in 5 days</span>
    </article>
    <article class="lms-card">
      <h4>System Design Reflection</h4>
      <p class="muted">Mentorship Sprint deliverable</p>
      <span class="status-chip good">Submitted</span>
    </article>
  </div>
</section>

<section class="lms-section">
