          <td>₦299,000</td>
          <td><span class="status-chip good">Paid</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="lms-section">
  <h2>Billing Actions</h2>
  <div class="lms-actions">
    <a class="lms-btn" href="/payment/enroll/web-dev"><i class="las la-credit-card"></i> Test Enrollment Route</a>
