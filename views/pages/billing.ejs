  <div class="lms-grid cols-3">
    <article class="lms-card">
      <h4>Current Plan</h4>
      <p class="metric">Mentorship Sprint</p>
      <p class="muted">Renews monthly</p>
    </article>
    <article class="lms-card">
      <h4>Next Charge</h4>
      <p class="metric">₦150,000</p>
      <p class="muted">Due in 12 days</p>
