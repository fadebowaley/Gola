<%- include("../partials/lms-layout-start", { lmsPageTitle, lmsActive }) %>

<section class="lms-section">
  <h2>Certificates</h2>
  <div class="lms-grid cols-2">
    <article class="lms-card">
      <h4>Foundations of Backend Engineering</h4>
      <p class="muted">Issued on January 18, 2026</p>
      <span class="status-chip good">Issued</span>
      <div class="lms-actions mt-3">
        <a class="lms-btn" href="#"><i class="las la-download"></i> Download</a>
        <a class="lms-btn" href="#"><i class="las la-share-alt"></i> Share</a>
      </div>
    </article>
    <article class="lms-card">
      <h4>AWS Practitioner Readiness</h4>
      <p class="muted">Awarded after completion of final assessment.</p>
