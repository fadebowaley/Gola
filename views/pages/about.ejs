<%- include("../partials/header", { pageTitle: "About - Gola" }) %>
<%- include("../partials/page-shell-start", { activePage: "about" }) %>

<section class="hero-section page-section scroll-to-page" id="about-overview">
  <div class="custom-container">
    <div class="hero-content content-width">
      <div class="page-intro">
        <span class="eyebrow scroll-animation" data-animation="fade_from_bottom">Profile</span>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">
          Building resilient products and research-backed systems
        </h1>
        <p class="scroll-animation" data-animation="fade_from_bottom">
          I work at the intersection of software engineering, cloud infrastructure, and technical education.
          This page summarizes what I build, how I lead teams, and where I focus my research.
        </p>
      </div>

      <div class="stats-strip">
        <div class="surface-card scroll-animation" data-animation="fade_from_left">
          <h4>10+ Years</h4>
          <p>Product engineering and team leadership across startups and enterprise environments.</p>
        </div>
        <div class="surface-card scroll-animation" data-animation="fade_from_bottom">
          <h4>9 Countries</h4>
          <p>Regional execution and technology delivery across diverse African markets.</p>
        </div>
        <div class="surface-card scroll-animation" data-animation="fade_from_right">
          <h4>3M+ Users Impacted</h4>
          <p>Programs and platforms delivered at scale with measurable user outcomes.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="about-area page-section scroll-to-page" id="journey">
  <div class="custom-container">
    <div class="about-content content-width">
      <div class="section-header">
        <h4 class="subtitle scroll-animation" data-animation="fade_from_bottom">
          <i class="lar la-user"></i> Journey
        </h4>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">Career <span>Highlights</span></h1>
      </div>
      <p class="scroll-animation" data-animation="fade_from_bottom">
        My path started from banking retail operations and grew into software architecture, data systems,
        and platform leadership. Over the years I have led delivery on production products, designed
        technical training programs, and shipped systems that prioritize stability, observability, and long-term maintainability.
      </p>
      <p class="scroll-animation" data-animation="fade_from_bottom">
        Today, I combine engineering execution with mentorship and research. I help teams move from
        idea to deployment while building internal capability and engineering discipline.
      </p>
    </div>
  </div>
</section>

<section class="services-area page-section scroll-to-page" id="capabilities">
  <div class="custom-container">
    <div class="services-content content-width">
      <div class="section-header">
        <h4 class="subtitle scroll-animation" data-animation="fade_from_bottom">
          <i class="las la-stream"></i> Capabilities
        </h4>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">
          Speaking, Research and <span>Delivery Focus</span>
        </h1>
      </div>

      <div class="row g-4">
        <div class="col-md-6 scroll-animation" data-animation="fade_from_left">
          <div class="surface-card">
            <h3>Speaking & Mentorship</h3>
            <p>
              I teach practical backend architecture, cloud reliability, developer workflows, and career
              progression for engineering teams and early-career developers.
            </p>
          </div>
        </div>
        <div class="col-md-6 scroll-animation" data-animation="fade_from_right">
          <div class="surface-card">
            <h3>Research & Innovation</h3>
            <p>
              My research direction focuses on scalable systems, AI-assisted product design, and data-informed
              engineering processes that improve quality and speed together.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="contact-area page-section scroll-to-page" id="next-step">
  <div class="custom-container">
    <div class="contact-content content-width">
      <div class="section-header">
        <h4 class="subtitle scroll-animation" data-animation="fade_from_bottom">
          <i class="las la-arrow-right"></i> Next
        </h4>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">
          Ready to learn or collaborate?
        </h1>
      </div>
      <p class="scroll-animation" data-animation="fade_from_bottom">
        Explore the learning platform or drop a project question and I will respond with a practical path forward.
      </p>
      <div class="d-flex flex-wrap gap-3 mt-3 scroll-animation" data-animation="fade_from_bottom">
        <a href="/learn" class="theme-btn"><i class="las la-graduation-cap"></i> Explore Learning</a>
        <a href="/ask" class="theme-btn"><i class="las la-question-circle"></i> Ask a Question</a>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/page-shell-end") %>
