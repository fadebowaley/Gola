<%- include("../partials/header", { pageTitle: "Ask - Gola" }) %>
<%- include("../partials/page-shell-start", { activePage: "ask" }) %>

<section class="hero-section page-section scroll-to-page" id="ask-hero">
  <div class="custom-container">
    <div class="hero-content content-width">
      <div class="page-intro">
        <span class="eyebrow scroll-animation" data-animation="fade_from_bottom">Support</span>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">Ask technical, learning, or project questions</h1>
        <p class="scroll-animation" data-animation="fade_from_bottom">
          Share context, your current stage, and what outcome you need. You will get a focused response
          that maps to either a learning path or an implementation path.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="contact-area page-section scroll-to-page" id="ask-form">
  <div class="custom-container">
    <div class="contact-content content-width">
      <div class="section-header">
        <h4 class="subtitle scroll-animation" data-animation="fade_from_bottom">
          <i class="las la-envelope"></i> Submit Question
        </h4>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">
          Let&apos;s Work <span>Together</span>
        </h1>
      </div>

      <p id="ask-form-alert"></p>

      <form class="contact-form scroll-animation" data-animation="fade_from_bottom" id="question-form">
        <div class="row">
          <div class="col-md-6">
            <div class="input-group">
              <label for="fullName">Full Name <sup>*</sup></label>
              <input type="text" id="fullName" name="fullName" placeholder="Your Full Name" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="input-group">
              <label for="email">Email <sup>*</sup></label>
              <input type="email" id="email" name="email" placeholder="Your Email Address" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="input-group">
              <label for="phone">Phone <span>(optional)</span></label>
              <input type="text" id="phone" name="phone" placeholder="Your Phone Number" />
            </div>
          </div>
          <div class="col-md-6">
            <div class="input-group">
              <label for="subject">Category <sup>*</sup></label>
              <select id="subject" name="subject" required>
                <option value="">Select a category</option>
                <option value="course-support">Course Support</option>
                <option value="mentorship">Mentorship</option>
                <option value="project-collaboration">Project Collaboration</option>
                <option value="general-inquiry">General Inquiry</option>
              </select>
            </div>
          </div>
          <div class="col-md-12">
            <div class="input-group">
              <label for="subjectSpec">Message Subject <sup>*</sup></label>
              <input type="text" id="subjectSpec" name="subjectSpec" placeholder="Brief summary of your question" required />
            </div>
          </div>
          <div class="col-md-12">
            <div class="input-group">
              <label for="message">Question <sup>*</sup></label>
              <textarea id="message" name="message" placeholder="Explain your current challenge and expected outcome..." required></textarea>
            </div>
          </div>
          <div class="col-md-12">
            <div class="input-group submit-btn-wrap">
              <button class="theme-btn" id="send-question" type="submit">
                Send Question
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="services-area page-section scroll-to-page" id="faq">
  <div class="custom-container">
    <div class="services-content content-width">
      <div class="section-header">
        <h4 class="subtitle scroll-animation" data-animation="fade_from_bottom">
          <i class="las la-info-circle"></i> FAQ
        </h4>
        <h1 class="scroll-animation" data-animation="fade_from_bottom">Quick <span>Answers</span></h1>
      </div>

      <div class="row g-4">
        <div class="col-md-6 scroll-animation" data-animation="fade_from_left">
          <div class="surface-card">
            <h4>Do I need experience before joining?</h4>
            <p>No. Paths are structured by level, and we provide a practical ramp from fundamentals to deployment.</p>
          </div>
        </div>
        <div class="col-md-6 scroll-animation" data-animation="fade_from_right">
          <div class="surface-card">
            <h4>How fast can I expect a response?</h4>
            <p>Typically within 24 hours for direct questions and onboarding requests.</p>
          </div>
        </div>
        <div class="col-md-6 scroll-animation" data-animation="fade_from_left">
          <div class="surface-card">
            <h4>Is mentorship project-based?</h4>
            <p>Yes. We use your real project context to build skills that transfer directly to production work.</p>
          </div>
        </div>
        <div class="col-md-6 scroll-animation" data-animation="fade_from_right">
          <div class="surface-card">
            <h4>Can teams request private sessions?</h4>
            <p>Yes. Team cohorts, architecture reviews, and internal training sessions are available.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const questionForm = document.getElementById("question-form");
  const alertBox = document.getElementById("ask-form-alert");

  if (questionForm && alertBox) {
    questionForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const payload = {
        fullName: questionForm.fullName.value.trim(),
        email: questionForm.email.value.trim(),
        phone: questionForm.phone.value.trim(),
        subject: questionForm.subject.value,
        subjectSpec: questionForm.subjectSpec.value.trim(),
        message: questionForm.message.value.trim(),
      };

      try {
        const response = await fetch("/send-message", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Unable to send question.");
        }

        alertBox.innerHTML =
          '<div class="alert alert-success" role="alert">Question received. You will get a response shortly.</div>';
        questionForm.reset();
      } catch (error) {
        alertBox.innerHTML =
          `<div class="alert alert-danger" role="alert">${error.message}</div>`;
      }
    });
  }
</script>

<%- include("../partials/page-shell-end") %>
