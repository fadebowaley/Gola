<%- include("../partials/lms-layout-start", { lmsPageTitle, lmsActive }) %>

<section class="lms-section">
  <h2>Learning Path Roadmap</h2>
  <div class="lms-grid cols-3">
    <article class="lms-card">
      <h4>Phase 1: Foundation</h4>
      <p class="muted">Core web architecture, JavaScript patterns, and backend fundamentals.</p>
      <div class="progress-track"><div class="progress-value" style="width: 100%"></div></div>
      <p class="muted mt-2">Completed</p>
    </article>
    <article class="lms-card">
      <h4>Phase 2: Build</h4>
      <p class="muted">Auth, data modeling, testing strategy, and API-first implementation.</p>
      <div class="progress-track"><div class="progress-value" style="width: 72%"></div></div>
      <p class="muted mt-2">In Progress - 72%</p>
    </article>
    <article class="lms-card">
      <h4>Phase 3: Deploy</h4>
      <p class="muted">Production releases, observability, and scale-readiness patterns.</p>
      <div class="progress-track"><div class="progress-value" style="width: 18%"></div></div>
      <p class="muted mt-2">Upcoming - 18%</p>
    </article>
  </div>
</section>

<section class="lms-section">
  <h2>Weekly Sprint Board</h2>
  <div class="table-wrap">
    <table class="lms-table">
      <thead>
        <tr>
          <th>Module</th>
          <th>Goal</th>
          <th>Status</th>
          <th>Deadline</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Auth Strategy</td>
          <td>Implement local + social sign-in flows</td>
          <td><span class="status-chip good">Complete</span></td>
          <td>Done</td>
        </tr>
        <tr>
          <td>Route Protection</td>
          <td>Apply role and verification guards</td>
          <td><span class="status-chip good">Complete</span></td>
          <td>Done</td>
        </tr>
        <tr>
          <td>LMS UX Structure</td>
          <td>Dashboard, tools, and learning nav design</td>
          <td><span class="status-chip">In Review</span></td>
          <td>Today</td>
        </tr>
        <tr>
          <td>Payment Completion</td>
          <td>Finalize Paystack checkout callback flow</td>
          <td><span class="status-chip warn">Pending</span></td>
          <td>Next Sprint</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="lms-section">
  <h2>Continue</h2>
  <div class="lms-actions">
    <a class="lms-btn primary" href="/user/assignments"><i class="las la-tasks"></i> Open Assignments</a>
    <a class="lms-btn" href="/user/progress"><i class="las la-chart-line"></i> View Progress</a>
    <a class="lms-btn" href="/courses"><i class="las la-book-open"></i> Browse Courses</a>
  </div>
</section>

<%- include("../partials/lms-layout-end") %>
